<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Separate from ../SaaSusSdk.Tests.csproj, which needs live credentials and
    committed snapshots. This project path and the test class names are the
    stable entry point: the workflow runs this same path on a previously
    released tag, whose own bundled copy is the (C) check.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SaasusSdk.Contract</RootNamespace>
    <AssemblyName>SaaSusSdk.Contract.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The specs are YAML; the request inputs are read from them. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../saasus-sdk-csharp.csproj" />
  </ItemGroup>
</Project>
